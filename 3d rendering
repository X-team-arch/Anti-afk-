-- Loop activo para impulsar el auto/barco cuando presiones ALT
altSpeedConn = RunService.Heartbeat:Connect(function()
    if altHeld then
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            local seat = char:FindFirstChildOfClass("Humanoid").SeatPart
            if seat and seat.Parent then
                local root = seat.Parent.PrimaryPart or seat
                local isBoat = seat.Parent:FindFirstChild("IsBoat") or seat.Name:lower():find("boat")
                local targetSpeed = isBoat and sdValues.boatAltSpeed or sdValues.vehicleAltSpeed
                root.AssemblyLinearVelocity = root.CFrame.LookVector * targetSpeed
            end
        end
    end
end)

SanDiegoTab:CreateToggle({
   Name = "Evasión de Obstáculos del Barco (Boat Avoidance)",
   CurrentValue = sdValues.boatObstacleAvoidance,
   Flag = "SDBoatAvoidance",
   Callback = function(Value)
        sdValues.boatObstacleAvoidance = Value
        if Value then
            boatAvoidanceConn = RunService.Heartbeat:Connect(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Humanoid") then
                    local seat = char:FindFirstChildOfClass("Humanoid").SeatPart
                    if seat and seat.Parent then
                        local root = seat.Parent.PrimaryPart or seat
                        local ray = Ray.new(root.Position, root.CFrame.LookVector * 25)
                        local hit = workspace:FindPartOnRayWithIgnoreList(ray, {char, seat.Parent})
                        if hit and hit.CanCollide then
                            root.AssemblyAngularVelocity = Vector3.new(0, 3, 0)
                        end
                    end
                end
            end)
        else
            if boatAvoidanceConn then boatAvoidanceConn:Disconnect() boatAvoidanceConn = nil end
        end
   end,
})

SanDiegoTab:CreateToggle({
   Name = "Estabilizador de Motocicleta (Motorbike Stabilizer)",
   CurrentValue = false,
   Flag = "SDMotorbikeStabilizer",
   Callback = function(Value)
        sdValues.motorbikeStabilizer = Value
        if Value then
            motorbikeConn = RunService.RenderStepped:Connect(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Humanoid") then
                    local seat = char:FindFirstChildOfClass("Humanoid").SeatPart
                    if seat and seat.Parent then
                        local root = seat.Parent.PrimaryPart or seat
                        local rx, ry, rz = root.CFrame:ToOrientation()
                        root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, ry, 0)
                    end
                end
            end)
        else
            if motorbikeConn then motorbikeConn:Disconnect() motorbikeConn = nil end
        end
   end,
})

SanDiegoTab:CreateButton({
   Name = "Recuperar Motocicleta (Recover Motorbike)",
   Callback = function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            local seat = char:FindFirstChildOfClass("Humanoid").SeatPart
            if seat and seat.Parent then
                local root = seat.Parent.PrimaryPart or seat
                root.CFrame = root.CFrame * CFrame.new(0, 3, 0)
                Rayfield:Notify({Title = "San Diego", Content = "Motocicleta recuperada.", Duration = 2})
            end
        else
            Rayfield:Notify({Title = "Error", Content = "Debes estar montado en la motocicleta.", Duration = 3})
        end
