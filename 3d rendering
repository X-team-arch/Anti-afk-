-- 🏎️ 3. VEHÍCULOS
-- ==========================================
VehiclesTab:Section({Name = "Vuelo de Auto"})

VehiclesTab:Toggle({
    Name = "Vuelo de Auto (Car Fly)",
    Default = false,
    Callback = function(Value)
        carFlying = Value
        if carFlying then
