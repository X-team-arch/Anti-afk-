-- Variables de Estado
local altHeld = false
local antiCollisionConn, borderLimitConn, boatAvoidanceConn, motorbikeConn, altSpeedConn
local noclipConn, infJumpConn, flyConn, antiAfkConn, carFlyConn, noRecoilConn
local flying = false
local carFlying = false
local flySpeed = 50
local carFlySpeed = 80

local sdSettings = {
    vehicleAltSpeed = 220,
    boatAltSpeed = 180,
    antiPit = false,
    boatAvoidance = false,
    motorbikeStabilizer = false
}

local function getMyVehicle()
    local char = LocalPlayer.Character
    if char and char:FindFirstChildOfClass("Humanoid") then
        local seat = char:FindFirstChildOfClass("Humanoid").SeatPart
        if seat and seat.Parent then
            return seat.Parent, seat
        end
    end
    return nil, nil
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and (input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt) then
        altHeld = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
        altHeld = false
    end
end)

-- ==========================================
-- 🇲🇽 1. SAN DIEGO BORDER
-- ==========================================
sdTab:CreateToggle({
    name = "Aɴᴛɪᴄᴏʟɪsɪᴏ́ɴ ᴅᴇ Vᴇʜɪ́ᴄᴜʟᴏs",
    flag = "SD_AntiCollision",
    value = false,
    callback = function(value)
        if value then
            antiCollisionConn = RunService.Stepped:Connect(function()
                local veh = getMyVehicle()
                if veh then
                    for _, part in pairs(veh:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        else
            if antiCollisionConn then antiCollisionConn:Disconnect() antiCollisionConn = nil end
        end
    end
})

sdTab:CreateToggle({
    name = "Sɪɴ Lɪ́ᴍɪᴛᴇ ᴇɴ Fʀᴏɴᴛᴇʀᴀ",
    flag = "SD_NoBorderLimit",
    value = false,
    callback = function(value)
        if value then
            borderLimitConn = RunService.Heartbeat:Connect(function()
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj.Name:lower():find("border") or obj.Name:lower():find("checkpoint") or obj.Name:lower():find("speedlimit") then
                        if obj:IsA("BasePart") then obj.CanTouch = false end
                    end
                end
            end)
        else
            if borderLimitConn then borderLimitConn:Disconnect() borderLimitConn = nil end
        end
    end
})

sdTab:CreateToggle({
    name = "Aɴᴛɪ PIT",
    flag = "SD_AntiPIT",
    value = false,
    callback = function(value)
        sdSettings.antiPit = value
        if value then
            RunService.Heartbeat:Connect(function()
                local veh, seat = getMyVehicle()
                if veh and sdSettings.antiPit then
                    local root = veh.PrimaryPart or seat
                    if root then root.AssemblyAngularVelocity = Vector3.new(0, root.AssemblyAngularVelocity.Y, 0) end
                end
            end)
        end
    end
})

sdTab:CreateToggle({
    name = "Eᴠᴀsɪᴏ́ɴ Bᴀʀᴄᴏ Aᴜᴛᴏ-Pɪʟᴏᴛ",
    flag = "SD_BoatAvoid",
    value = false,
    callback = function(value)
        sdSettings.boatAvoidance = value
        if value then
            boatAvoidanceConn = RunService.Heartbeat:Connect(function()
                local veh, seat = getMyVehicle()
                if veh and seat then
                    local root = veh.PrimaryPart or seat
                    local rayParams = RaycastParams.new()
                    rayParams.FilterDescendantsInstances = {veh, LocalPlayer.Character}
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude

                    local result = Workspace:Raycast(root.Position, root.CFrame.LookVector * 30, rayParams)
                    if result and result.Instance.CanCollide then
                        root.AssemblyAngularVelocity = Vector3.new(0, 4, 0)
                    end
                end
            end)
        else
            if boatAvoidanceConn then boatAvoidanceConn:Disconnect() boatAvoidanceConn = nil end
        end
    end
})

sdTab:CreateToggle({
    name = "E sᴛᴀʙɪʟɪᴢᴀᴅᴏʀ ᴅᴇ Mᴏᴛᴏ",
    flag = "SD_MotoStab",
    value = false,
    callback = function(value)
        sdSettings.motorbikeStabilizer = value
        if value then
            motorbikeConn = RunService.RenderStepped:Connect(function()
                local veh, seat = getMyVehicle()
                if veh and seat then
                    local root = veh.PrimaryPart or seat
                    local rx, ry, rz = root.CFrame:ToOrientation()
                    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, ry, 0)
                end
            end)
        else
            if motorbikeConn then motorbikeConn:Disconnect() motorbikeConn = nil end
        end
    end
})

sdTab:CreateButton({
    name = "Eɴᴅᴇʀᴇᴢᴀʀ Vᴇʜɪ́ᴄᴜʟᴏ",
    callback = function()
        local veh, seat = getMyVehicle()
        if veh and seat then
            local root = veh.PrimaryPart or seat
            root.CFrame = CFrame.new(root.Position + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.rad(root.Orientation.Y), 0)
        end
    end
})

altSpeedConn = RunService.Heartbeat:Connect(function()
    if altHeld then
        local veh, seat = getMyVehicle()
        if veh and seat then
            local root = veh.PrimaryPart or seat
            local isBoat = veh.Name:lower():find("boat") or veh.Name:lower():find("lancha") or seat.Name:lower():find("boat")
            local speed = isBoat and sdSettings.boatAltSpeed or sdSettings.vehicleAltSpeed
            root.AssemblyLinearVelocity = root.CFrame.LookVector * speed
        end
    end
end)

