-- Pestañas
local SanDiegoTab = Window:Tab({Name = "San Diego", Icon = "rbxassetid://10723345831"})
local CombatTab = Window:Tab({Name = "Combate", Icon = "rbxassetid://10723346158"})
local VehiclesTab = Window:Tab({Name = "Vehículos", Icon = "rbxassetid://10723346376"})
local MovementTab = Window:Tab({Name = "Movimiento", Icon = "rbxassetid://10723346552"})
