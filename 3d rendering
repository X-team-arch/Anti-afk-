local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local VirtualUser = game:GetService("VirtualUser")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

-- Ventana Principal con Guardado de Configuración
local Window = Rayfield:CreateWindow({
   Name = "UrielAfk",
   Icon = 0,
   LoadingTitle = "Cargando UrielAfk...",
   LoadingSubtitle = "por Uriel",
   Theme = "Default",
   DisableRayfieldPrompts = false,
   DisableBuildWarnings = false,
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "UrielAfkConfigs",
      FileName = "UrielAfk_Config"
   },
   Discord = { Enabled = false },
   KeySystem = false
})

-- Pestañas Principales
local AFKTab = Window:CreateTab("AFK & Render", 4483362458)
local ESPTab = Window:CreateTab("Visión & ESP", 4483362458)
local MovementTab = Window:CreateTab("Movimiento", 4483362458)
local SanDiegoTab = Window:CreateTab("San Diego", 4483362458)
local UtilitiesTab = Window:CreateTab("Utilidades", 4483362458)
local ConfigTab = Window:CreateTab("Configuración", 4483362458)

-- Variables de Control
local antiAfkConn, noclipConn, infJumpConn, flyConn, antiCollideConn, vehicleNoclipConn
local flying = false
local flySpeed = 50
local originalLighting = {
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    FogEnd = Lighting.FogEnd,
    GlobalShadows = Lighting.GlobalShadows
}

-- ==========================================
-- 1. AFK & RENDIMIENTO
-- ==========================================

AFKTab:CreateToggle({
   Name = "Desactivar 3D Rendering (Ahorro GPU/Batería)",
   CurrentValue = false,
   Flag = "Toggle3D",
   Callback = function(Value)
        RunService:Set3dRenderingEnabled(not Value)
        Rayfield:Notify({
            Title = "3D Rendering", 
            Content = Value and "Renderizado 3D pausado (Pantalla estática)." or "Renderizado 3D reanudado.", 
            Duration = 3.5
        })
   end,
})

AFKTab:CreateToggle({
   Name = "Anti-AFK (Impidiendo Desconexión)",
   CurrentValue = false,
   Flag = "ToggleAntiAFK",
   Callback = function(Value)
        if Value then
            antiAfkConn = LocalPlayer.Idled:Connect(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
            Rayfield:Notify({Title = "Anti-AFK", Content = "Protección 24/7 activada.", Duration = 3})
        else
            if antiAfkConn then antiAfkConn:Disconnect() antiAfkConn = nil end
            Rayfield:Notify({Title = "Anti-AFK", Content = "Protección desactivada.", Duration = 3})
        end
   end,
})

AFKTab:CreateSlider({
   Name = "Limitador de FPS",
   Range = {10, 60},
   Increment = 5,
   Suffix = " FPS",
   CurrentValue = 60,
   Flag = "FPSCapSlider",
   Callback = function(Value)
        if setfpscap then
            setfpscap(Value)
        end
   end,
})

AFKTab:CreateButton({
   Name = "CPU Booster (Remover Texturas)",
   Callback = function()
        for _, obj in pairs(game:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
            elseif obj:IsA("Texture") or obj:IsA("Decal") then
                obj:Destroy()
            end
        end
        Rayfield:Notify({Title = "CPU Booster", Content = "Texturas simplificadas.", Duration = 3})
   end,
})

-- ==========================================
-- 2. VISIÓN Y ESP
-- ==========================================

ESPTab:CreateToggle({
   Name = "ESP de Jugadores (Resaltar Jugadores)",
   CurrentValue = false,
   Flag = "ToggleESP",
   Callback = function(Value)
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local hl = player.Character:FindFirstChild("UrielESP")
                if Value then
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "UrielESP"
                        hl.FillColor = Color3.fromRGB(0, 170, 255)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.Parent = player.Character
                    end
                else
                    if hl then hl:Destroy() end
                end
            end
        end
   end,
})

ESPTab:CreateToggle({
   Name = "Fullbright (Visión Nocturna)",
   CurrentValue = false,
   Flag = "ToggleFullbright",
   Callback = function(Value)
        if Value then
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
        else
            Lighting.Brightness = originalLighting.Brightness
            Lighting.ClockTime = originalLighting.ClockTime
            Lighting.FogEnd = originalLighting.FogEnd
            Lighting.GlobalShadows = originalLighting.GlobalShadows
        end
   end,
})

-- ==========================================
-- 3. MOVIMIENTO
-- ==========================================

MovementTab:CreateSlider({
   Name = "Velocidad de Caminado (WalkSpeed)",
   Range = {16, 250},
   Increment = 1,
   Suffix = " Studs",
   CurrentValue = 16,
   Flag = "WalkSpeedSlider",
   Callback = function(Value)
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            LocalPlayer.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = Value
        end
   end,
})

MovementTab:CreateToggle({
   Name = "Salto Infinito",
   CurrentValue = false,
   Flag = "InfJumpToggle",
   Callback = function(Value)
        if Value then
            infJumpConn = UserInputService.JumpRequest:Connect(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                    LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
                end
            end)
        else
            if infJumpConn then infJumpConn:Disconnect() infJumpConn = nil end
        end
   end,
})

MovementTab:CreateToggle({
   Name = "Noclip (Atravesar Paredes)",
   CurrentValue = false,
   Flag = "NoclipToggle",
   Callback = function(Value)
        if Value then
            noclipConn = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        else
            if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        end
   end,
})

MovementTab:CreateToggle({
   Name = "Vuelo (Fly)",
   CurrentValue = false,
   Flag = "FlyToggle",
   Callback = function(Value)
        flying = Value
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart

        if flying then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "UrielFly"
            bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bv.Parent = hrp

            flyConn = RunService.RenderStepped:Connect(function()
                if flying and hrp:FindFirstChild("UrielFly") then
                    local cam = workspace.CurrentCamera
                    bv.Velocity = cam.CFrame.LookVector * flySpeed
                end
            end)
        else
            if hrp:FindFirstChild("UrielFly") then hrp.UrielFly:Destroy() end
            if flyConn then flyConn:Disconnect() flyConn = nil end
        end
   end,
})

-- ==========================================
-- 4. SAN DIEGO BORDER (MÓDULO DE VEHÍCULOS)
-- ==========================================

SanDiegoTab:CreateToggle({
   Name = "Anti-Collision / Anti-PIT (Vehículo)",
   CurrentValue = false,
   Flag = "SanDiegoAntiCollide",
   Callback = function(Value)
        if Value then
            antiCollideConn = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").SeatPart then
                    local seat = char:FindFirstChildOfClass("Humanoid").SeatPart
                    local vehicle = seat.Parent
                    if vehicle then
                        for _, part in pairs(vehicle:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanTouch = false
                            end
                        end
                    end
                end
            end)
            Rayfield:Notify({Title = "San Diego", Content = "Anti-Collision activado.", Duration = 3})
        else
            if antiCollideConn then antiCollideConn:Disconnect() antiCollideConn = nil end
            Rayfield:Notify({Title = "San Diego", Content = "Anti-Collision desactivado.", Duration = 3})
        end
   end,
})

SanDiegoTab:CreateToggle({
   Name = "Atravesar Paredes con Auto (Vehicle Noclip)",
   CurrentValue = false,
   Flag = "SanDiegoNoclip",
   Callback = function(Value)
        if Value then
            vehicleNoclipConn = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").SeatPart then
                    local vehicle = char:FindFirstChildOfClass("Humanoid").SeatPart.Parent
                    if vehicle then
                        for _, part in pairs(vehicle:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end
            end)
        else
            if vehicleNoclipConn then vehicleNoclipConn:Disconnect() vehicleNoclipConn = nil end
        end
   end,
})

SanDiegoTab:CreateButton({
   Name = "Voltear Vehículo (Auto-Flip)",
   Callback = function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").SeatPart then
            local seat = char:FindFirstChildOfClass("Humanoid").SeatPart
            local vehicle = seat.Parent
            if vehicle then
                local rootPart = vehicle.PrimaryPart or seat
                rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, 0, math.pi)
                Rayfield:Notify({Title = "San Diego", Content = "Vehículo enderezado.", Duration = 2})
            end
        else
            Rayfield:Notify({Title = "Error", Content = "Debes estar dentro de un vehículo.", Duration = 3})
        end
   end,
})

-- ==========================================
-- 5. UTILIDADES
