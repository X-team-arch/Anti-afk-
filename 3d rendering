VehiclesTab:Slider({
    Name = "Velocidad Vuelo Coche",
    Min = 30,
    Max = 300,
    Default = 80,
    Callback = function(Value) carFlySpeed = Value end
})

VehiclesTab:Button({
    Name = "Freno Instantáneo",
    Callback = function()
        local veh, seat = getMyVehicle()
        if veh and seat then
            local root = veh.PrimaryPart or seat
